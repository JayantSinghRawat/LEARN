<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whatsapp</title>
    <link rel = "stylesheet" href="style.css">
</head>
<body>
    <h1>ALL CHATS</h1>
    <form method = "GET" action="/chats/new" class = "new">
        <button>NEW CHAT</button>
    </form>
    <br>
    <br>
    <% for(let chat of chats) {%>
        <div class = "chat">
            <p>From : <%= chat.from %></p>
            <div class = "msg">
                <p><%= chat.msg %></p>
            </div>
            <p>Recived by : <%= chat.to %></p>
            <hr>
            <p><%= chat.created_at.toString().split(" ")[4]%></p><br>
             <p><%= chat.created_at.toString().split(" ").splice(0,4).join(" ")%></p><br>
             <form method = "get" action="/chats/<%= chat._id%>">
                <button>show</button>
             </form>
             <form method = "get" action="/chats/<%= chat._id%>/edit">
                <button>edit</button>
             </form>
             <form method = "post" action = "/chats/<%= chat.id%>?_method=DELETE">
                <button>Delete</button>
            </form>
        </div>
        <br>
    <% }%>    
    
</body>
</html>