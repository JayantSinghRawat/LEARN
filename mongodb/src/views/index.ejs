<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whatsapp</title>
    <link rel = "stylesheet" href="style.css">
</head>
<body>
    <h1>ALL CHATS</h1>
    <form method = "GET" action="/chats/new" class = "new">
        <button>NEW CHAT</button>
    </form>
    <br>
    <br>
    <% for(let chat of chats) {%>
        <div class = "chat">
            <p>From : <%= chat.from %></p>
            <div class = "msg">
                <p><%= chat.msg %></p>
            </div>
            <p>Recived by : <%= chat.to %></p>
            <hr>
        </div>
        <br>
    <% }%>    
    
</body>
</html>